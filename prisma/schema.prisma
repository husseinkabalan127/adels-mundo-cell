generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  nome               String
  email              String    @unique
  senha              String
  role               Role      @default(FUNCIONARIO)
  ativo              Boolean   @default(true)
  resetCode          String?
  resetCodeExpiresAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Produto {
  id            Int           @id @default(autoincrement())
  nome          String
  quantidade    Int           @default(0)
  createdAt     DateTime      @default(now())
  precoVendaUsd Float?
  precoVendaBrl Float?
  tipoPreco     String?
  aparelhos     Aparelho[]
  assistencias  Assistencia[]
  garantias     Garantia[]
  lotes         Lote[]
  vendasLegadas Venda[]       @relation("VendaProdutoLegado")
  vendas        VendaItem[]
}

model Lote {
  id             Int        @id @default(autoincrement())
  fornecedor     String?
  precoCompraUsd Float?
  precoCompraBrl Float?
  tipoCusto      String?
  quantidade     Int        @default(0)
  observacao     String?
  createdAt      DateTime   @default(now())
  produtoId      Int
  aparelhos      Aparelho[]
  produto        Produto    @relation(fields: [produtoId], references: [id])
}

model Aparelho {
  id           Int           @id @default(autoincrement())
  imei         String        @unique
  vendido      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  loteId       Int
  produtoId    Int
  vendaItemId  Int?
  lote         Lote          @relation(fields: [loteId], references: [id])
  produto      Produto       @relation(fields: [produtoId], references: [id])
  vendaItem    VendaItem?    @relation(fields: [vendaItemId], references: [id])
  assistencias Assistencia[]
}

model Venda {
  id             Int         @id @default(autoincrement())
  cliente        String
  taxa           Float?
  taxaFechada    Boolean     @default(false)
  dataVenda      DateTime    @default(now())
  createdAt      DateTime    @default(now())
  produtoId      Int?
  quantidade     Int?
  valorVenda     Float?
  precoCompraUsd Float?
  formaPagamento String?     @default("Não informado")
  estadoFatura   String?     @default("Em aberto")
  desconto       Float       @default(0)
  pagamentos     Pagamento[]
  produto        Produto?    @relation("VendaProdutoLegado", fields: [produtoId], references: [id])
  itens          VendaItem[]
}

model VendaItem {
  id             Int        @id @default(autoincrement())
  quantidade     Int
  valorUnitario  Float
  total          Float
  precoCompraUsd Float?
  custoTotal     Float?
  createdAt      DateTime   @default(now())
  vendaId        Int
  produtoId      Int
  aparelhos      Aparelho[]
  produto        Produto    @relation(fields: [produtoId], references: [id])
  venda          Venda      @relation(fields: [vendaId], references: [id])
}

model Pagamento {
  id         Int      @id @default(autoincrement())
  valor      Float
  desconto   Float    @default(0)
  forma      String?
  observacao String?
  createdAt  DateTime @default(now())
  vendaId    Int
  venda      Venda    @relation(fields: [vendaId], references: [id])
}

model Garantia {
  id         Int      @id @default(autoincrement())
  cliente    String
  telefone   String?
  tipo       String
  inicio     DateTime
  fim        DateTime
  observacao String?
  createdAt  DateTime @default(now())
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
}

model Assistencia {
  id          Int       @id @default(autoincrement())
  cliente     String
  telefone    String?
  problema    String
  observacao  String?
  status      String    @default("Pendente")
  custo       Float     @default(0)
  dataEntrada DateTime  @default(now())
  dataSaida   DateTime?
  createdAt   DateTime  @default(now())
  produtoId   Int
  aparelhoId  Int?
  aparelho    Aparelho? @relation(fields: [aparelhoId], references: [id])
  produto     Produto   @relation(fields: [produtoId], references: [id])
}

enum Role {
  ADMIN
  FUNCIONARIO
}
